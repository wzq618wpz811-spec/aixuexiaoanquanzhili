{
  "name": "campus-safety-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test test/core.test.mjs test/local-product.test.mjs test/batches.test.mjs test/submission.test.mjs test/offline.test.mjs test/revision.test.mjs",
    "submission": "node scripts/build/submission.mjs",
